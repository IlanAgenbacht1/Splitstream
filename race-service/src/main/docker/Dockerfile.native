# A GraalVM native executable on a minimal base image. Build it first, in a container so no local GraalVM is needed:
#   ./mvnw -pl race-service -am package -DskipTests -Dnative -Dquarkus.native.container-build=true
#
# UBI 9, because the Mandrel builder links against its glibc (2.34). On the UBI 8 micro image (glibc 2.28) the
# executable won't start.
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work && chmod "g+rwX" /work && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application
EXPOSE 8081
USER 1001
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
